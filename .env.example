# UniFi MCP Server - Environment Configuration
# Supports 3 API modes: local, cloud-v1, cloud-ea

# ============================================
# API Mode (default: local)
# Options: local | cloud-v1 | cloud-ea
# ============================================
UNIFI_API_TYPE=local

# ============================================
# Cloud API (cloud-v1, cloud-ea)
# ============================================
UNIFI_API_KEY=your-cloud-api-key

# ============================================
# Local Controller (local)
# ============================================
UNIFI_LOCAL_HOST=192.168.100.1
UNIFI_LOCAL_PORT=443
UNIFI_LOCAL_VERIFY_SSL=false
# For local controller auth (alternative to API key):
# UNIFI_SESSION_COOKIE=your-session-cookie
# UNIFI_CSRF_TOKEN=your-csrf-token

# ============================================
# Optional
# ============================================
UNIFI_TIMEOUT=30000
