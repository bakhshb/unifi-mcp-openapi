# UniFi MCP Server - Quick Setup
# Copy this to .env and fill in your values

# ============================================
# API Mode - Choose ONE:
#   cloud-ea  (RECOMMENDED - UniFi Cloud API)
#   cloud-v1  (Legacy UniFi Cloud API)
#   local     (Self-hosted UniFi Dream Machine)
# ============================================
UNIFI_API_TYPE=cloud-ea

# ============================================
# For Cloud API (cloud-ea or cloud-v1):
# Get your API key from: https://account.ui.com
# ============================================
UNIFI_API_KEY=your-api-key-here

# ============================================
# For Local Controller only:
# ============================================
# UNIFI_LOCAL_HOST=192.168.1.1
# UNIFI_LOCAL_VERIFY_SSL=false
