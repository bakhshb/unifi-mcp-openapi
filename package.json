{
  "name": "unifi-mcp-openapi",
  "version": "1.0.0",
  "description": "MCP Server for UniFi Network Cloud API",
  "main": "build/index.js",
  "bin": {
    "unifi-mcp": "build/index.js"
  },
  "files": [
    "build",
    "reference.json"
  ],
  "scripts": {
    "build": "npm run clean && tsc && chmod 755 build/index.js",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "modelcontextprotocol",
    "mcp",
    "unifi",
    "ubiquiti"
  ],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.12.0",
    "axios": "^1.9.0",
    "zod": "3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3"
  }
}
